  function normalize(value) {
    return String(value || "").toLowerCase().replace(/\s+/g, "");
  }

  function subjectValue(hints, fallback) {
    const subjects = Array.isArray(data.subjects) ? data.subjects : [];

    for (const item of subjects) {
      const value = typeof item === "string"
        ? item
        : String(item.id || item.name || item.subject || item.title || "");

      const label = typeof item === "string"
        ? item
        : String(item.name || item.title || item.subject || value);

      const combined = normalize(value + label);

      if (hints.some(hint => combined.includes(normalize(hint)))) {
        return value;
      }
    }

    return fallback;
  }

